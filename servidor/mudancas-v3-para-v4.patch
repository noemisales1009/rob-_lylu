+      if (!isObj(r) || !titulo) return;
+      const id = limpo(r.id, 64);
+      const quando = limpo(r.quando, 32);
+      const dia = limpo(r.dia, 40);
+      const chave = id ? `id:${id}` : `t:${titulo}|${quando ?? dia ?? ""}`;
+      if (linhas.has(chave)) return;
+      linhas.set(chave, {
